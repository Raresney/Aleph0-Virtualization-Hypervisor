# Kernel configuration fragment for the first-boot Linux target, merged onto
# x86_64_defconfig by build.sh, which fails if any line here does not reach
# the final .config. See docs/LINUX_GUEST.md.

# Started as BOOTX64.EFI by the firmware's boot manager, the EFI stub gets no
# command line from anyone, so it is built in, and whatever a boot entry
# passes is ignored. earlycon prints from the start of the kernel, before the
# 8250 driver is up; nokaslr keeps kernel addresses the same on every boot, so
# guest RIPs can be looked up in System.map.
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="console=ttyS0,115200 earlycon=uart8250,io,0x3f8,115200 nokaslr"
CONFIG_CMDLINE_OVERRIDE=y

# One file the firmware starts: the EFI stub with the initramfs built in
# (build.sh adds the initramfs source, the list it writes).
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y

# ttyS0 is COM1; each kernel line carries its time since boot.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_PRINTK_TIME=y

# Hyper-V guest support is on, so the kernel detects Hyper-V. The VMBus
# drivers are off: nothing on an initramfs needs a disk or a network.
CONFIG_HYPERVISOR_GUEST=y
# CONFIG_HYPERV is not set
